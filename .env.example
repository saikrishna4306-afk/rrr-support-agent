# Copy to .env and fill in. NEVER commit .env or any API key.
# Deterministic, offline defaults for tests and local learning.
LLM_PROVIDER=mock
EMBED_PROVIDER=hash
VECTOR_STORE=numpy

# openai_compat uses these legacy-compatible settings.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_FALLBACK=

# Gemini settings. Add values only in your private .env.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=
GEMINI_EMBED_MODEL=
# Set GEMINI_STT_MODEL only when using STT_PROVIDER=gemini. Gemini TTS is deliberately
# not enabled until its SDK audio response has been verified for this project.
GEMINI_STT_MODEL=
GEMINI_TTS_MODEL=

# Voice defaults are offline mocks. Provider values: mock, gemini, gnani (STT);
# mock, edge, gnani (TTS). Fallback runs only when the selected provider fails.
STT_PROVIDER=mock
STT_FALLBACK=gemini
TTS_PROVIDER=mock
TTS_FALLBACK=edge
MAX_AUDIO_BYTES=2097152
MAX_AUDIO_SECONDS=30
AUDIO_CACHE_PATH=audio_cache

# Gnani Vachana REST configuration; retain these credentials only in private .env files.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE_TE=
GNANI_TTS_VOICE_HI=
GNANI_TTS_VOICE_EN=
EDGE_TTS_VOICE_TE=te-IN-ShrutiNeural
EDGE_TTS_VOICE_HI=hi-IN-SwaraNeural
EDGE_TTS_VOICE_EN=en-IN-NeerjaNeural
# Confirm commercial rates with Gnani before changing these placeholders.
GNANI_STT_UNIT_COST=0
GNANI_TTS_UNIT_COST=0

# EMBED_BACKEND remains supported when EMBED_PROVIDER is empty.
EMBED_BACKEND=hash
EMBED_MODEL=BAAI/bge-m3
# Tune separately after switching embedding providers: python -m tests.run_eval
CONFIDENCE_THRESHOLD_HASH=0.20
CONFIDENCE_THRESHOLD_GEMINI=0.45
CONFIDENCE_THRESHOLD_BGE_M3=0.45
TOP_K=3
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

# NumpyStore is the small cloud-default index. Chroma is optional local development.
NUMPY_PATH=numpy_index
CHROMA_PATH=chroma_db
DOCS_PATH=data/sample_docs
# DATABASE_URL wins when supplied; SQLITE_URL remains supported locally.
DATABASE_URL=
SQLITE_URL=sqlite:///support.db
ALLOWED_ORIGINS=http://localhost:5173

# Milestones 2-5: media evidence, technician dashboard/API, notification webhook, reranking.
# Create a high-entropy private token before enabling technician endpoints.
EVIDENCE_PATH=evidence
MAX_EVIDENCE_BYTES=5242880
TECHNICIAN_TOKEN=
# Generic POST webhook for ticket.created (connect Telegram/email automation externally).
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
RERANK_ENABLED=true
